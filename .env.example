# CyberShield AI - Environment Configuration
# ===========================================
# Copy this file to .env and fill in your actual values

# Flask Environment
# Options: development, production, testing
FLASK_ENV=development

# Security
# CRITICAL: Change this to a strong random string in production
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-long-random-value

# Database
# Development: uses SQLite (no configuration needed)
# Production: use PostgreSQL
DATABASE_URL=sqlite:///instance/cybershield.db
# DATABASE_URL=postgresql://user:password@localhost:5432/cybershield

# Application Settings
APP_NAME=CyberShield AI
APP_VERSION=2.0.0

# Server Configuration
HOST=0.0.0.0
PORT=5000

# Logging
LOG_LEVEL=INFO

# Security Headers
SECURITY_HEADERS_ENABLED=true

# Rate Limiting
RATELIMIT_ENABLED=true

# Session Configuration
PERMANENT_SESSION_LIFETIME_DAYS=7

# File Upload
MAX_CONTENT_LENGTH_MB=10
UPLOAD_FOLDER=instance/uploads

# CORS (Cross-Origin Resource Sharing)
# Enable only if your frontend is on a different domain
CORS_ENABLED=false
# CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# Email Configuration (for future features)
# MAIL_SERVER=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USE_TLS=true
# MAIL_USERNAME=your-email@gmail.com
# MAIL_PASSWORD=your-app-password

# API Keys (for future integrations)
# VIRUSTOTAL_API_KEY=your_virustotal_api_key
# OPENAI_API_KEY=your_openai_api_key

# Cloud Storage (for production file uploads)
# AWS_ACCESS_KEY_ID=your_aws_access_key
# AWS_SECRET_ACCESS_KEY=your_aws_secret_key
# S3_BUCKET_NAME=cybershield-uploads
# AWS_REGION=us-east-1

# Redis (for production rate limiting and caching)
# REDIS_URL=redis://localhost:6379/0

# Monitoring & Analytics
# SENTRY_DSN=your_sentry_dsn_for_error_tracking

# Development Settings
# Set to false in production
DEBUG=true
TESTING=false

